# Application Settings
PROJECT_NAME="VisionQC - Yapay Zeka Destekli Kalite Kontrol ve Etiketleme Sistemi"
VERSION="2.0.0"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# Seçenek 1: NeonDB Serverless PostgreSQL (Varsayılan Bulut)
# DATABASE_URL="postgresql+asyncpg://neondb_owner:<password>@ep-sample-pooler.c-2.neon.tech/neondb?sslmode=require"

# Seçenek 2: Docker Compose Dahili PostgreSQL (db servisi)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/visionqc"

# Seçenek 3: Yerel SQLite alternatifi:
# DATABASE_URL="sqlite+aiosqlite:///./visionqc.db"

# İsteğe Bağlı SSL Yapılandırması (Bulut için otomatik tespit edilir; yerel/docker için false bırakılabilir)
# DB_SSL=false

# LLM / Model Sağlayıcı Seçimi ("gemini" veya "openai")
LLM_PROVIDER="gemini"

# Google Gemini API Yapılandırması (https://aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Alternatif: OpenAI API Yapılandırması
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:4173","http://localhost:8000"]
